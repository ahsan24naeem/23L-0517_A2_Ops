# "Before" image for Task 6.4 - deliberately unoptimised, for the size comparison only.
# Full python base, full TensorFlow wheel, pip cache kept, no .dockerignore effect
# (build with:  docker build -f docker/Dockerfile.naive --no-cache -t vg-naive .  from a copy
#  of the repo without .dockerignore), source copied before dependencies.
FROM python:3.11
WORKDIR /app
COPY . .
RUN pip install -r requirements-app.txt tensorflow==2.19.0 keras==3.15.1
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "app.wsgi:app"]
