# Copy to .env and fill in. .env is git-ignored and docker-ignored - never commit it.
# ---- database (Compose) ----
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=change-me-use-letters-and-digits
# ---- web app ----
INFERENCE_MODE=local            # local = load model in the web container, remote = call MODEL_API_URL
MODEL_PATH=models/champion.keras
THRESHOLD=                      # empty -> use the threshold stored next to the model (champion.json)
MAX_UPLOAD_MB=5
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets.token_hex-32
FLASK_DEBUG=0
WEB_PORT=8000
# ---- remote model API (Task 7/8) ----
MODEL_API_URL=http://<oracle-vm-public-ip>:8000
MODEL_API_KEY=generate-a-long-random-string
# ---- MLflow on DagsHub (Task 3) ----
MLFLOW_TRACKING_URI=https://dagshub.com/ahsan24naeem/23L-0517_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=ahsan24naeem
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>
